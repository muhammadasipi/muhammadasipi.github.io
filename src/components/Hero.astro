  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col-reverse items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="max-w-[65ch]">
        <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">
          MS Materials Science and Engineering, KFUPM
        </p>
        <h1 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-5xl sm:leading-[1.15]">
          M Asipi Qostolani
        </h1>
        <p data-i18n="hero.role" class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">
          Membrane and materials researcher: membrane distillation, desalination, and computational modeling
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#research"
            data-i18n="hero.cta.research"
            class="inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-5 py-2.5 text-sm font-medium text-white dark:text-slate-950 hover:opacity-90"
          >
            View Research
          </a>
          <a
            href="#contact"
            data-i18n="hero.cta.contact"
            class="inline-flex min-h-[44px] items-center justify-center rounded border border-border bg-elevated px-5 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
          >
            Contact Me
          </a>
          {site.cvUrl && (
            <a
              href={site.cvUrl}
              download
              data-i18n="hero.cta.cv"
              class="inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
            >
              Download CV
            </a>
          )}
        </div>
      </div>

      {site.photoUrl ? (
        <img
          src={site.photoUrl}
          alt="Portrait of M Asipi Qostolani"
          width="128"
          height="128"
          class="h-28 w-28 shrink-0 rounded border border-border object-cover sm:h-32 sm:w-32"
        />
      ) : (
        <div
          aria-hidden="true"
          class="flex h-28 w-28 shrink-0 items-center justify-center rounded border border-border bg-elevated sm:h-32 sm:w-32"
        >
          <span class="font-sans text-2xl font-semibold tracking-tight text-accent">MAQ</span>
        </div>
      )}
    </div>
  </div>
</section>
