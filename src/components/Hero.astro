<section class="border-b border-border py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col-reverse items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="max-w-[65ch]">
        <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">
          MS Materials Science and Engineering, KFUPM
        </p>
        <h1 class="font-serif text-3xl font-normal tracking-tight text-ink sm:text-5xl sm:leading-[1.15]">
          M Asipi Qostolani
        </h1>
        <p data-i18n="hero.role" class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">
          Membrane and materials researcher: membrane distillation, desalination, and computational modeling
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            data-i18n="hero.cta.research"
            class="inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-5 py-2.5 text-sm font-medium text-white dark:text-slate-950 hover:opacity-90"
          >
            View Research
          </a>
          <a
            href="#contact"
            data-i18n="hero.cta.contact"
            class="inline-flex min-h-[44px] items-center justify-center rounded border border-border bg-elevated px-5 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent"
          >
            Contact Me
          </a>
          <span
            data-i18n="hero.cta.cv"
            title="Place CV PDF in public/ and update link"
            class="inline-flex min-h-[44px] items-center justify-center rounded border border-dashed border-border px-4 py-2.5 font-mono text-xs text-muted"
          >
            Download CV [TODO]
          </span>
        </div>
      </div>

      <div
        aria-label="Profile portrait placeholder"
        class="flex h-28 w-28 shrink-0 flex-col items-center justify-center rounded border border-dashed border-border bg-elevated text-center sm:h-32 sm:w-32"
      >
        <span class="font-serif text-xl text-ink">MAQ</span>
        <span class="mt-1 font-mono text-[11px] text-accent">[TODO: Photo]</span>
      </div>
    </div>
  </div>
</section>
