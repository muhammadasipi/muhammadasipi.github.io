---
interface Props {
  hasNotes?: boolean;
}
const { hasNotes = false } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-border bg-surface/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
    <a
      href="/"
      class="inline-flex min-h-[44px] items-center font-serif text-lg font-medium tracking-tight text-ink hover:text-accent"
    >
      M Asipi Qostolani
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      <a href="/#about" data-i18n="nav.about" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">About</a>
      <a href="/#research" data-i18n="nav.research" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Research</a>
      <a href="/#projects" data-i18n="nav.projects" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Projects</a>
      <a href="/#publications" data-i18n="nav.publications" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Publications</a>
      <a href="/#skills" data-i18n="nav.skills" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Skills</a>
      {hasNotes && (
        <a href="/notes" data-i18n="nav.notes" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Notes</a>
      )}
      <a href="/#contact" data-i18n="nav.contact" class="inline-flex min-h-[44px] items-center px-3 text-sm text-muted hover:text-ink">Contact</a>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="lang-toggle"
        type="button"
        aria-label="Switch language between English and Indonesian"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded border border-border bg-elevated px-3 font-mono text-xs font-medium text-ink hover:border-accent hover:text-accent"
      >
        EN / ID
      </button>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark and light theme"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded border border-border bg-elevated px-3 text-xs font-medium text-ink hover:border-accent hover:text-accent"
      >
        <span class="dark:hidden">Dark</span>
        <span class="hidden dark:inline">Light</span>
      </button>
    </div>
  </div>
</header>
