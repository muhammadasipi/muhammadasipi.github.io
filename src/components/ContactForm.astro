---
import { site } from '../site.config';

const formspreeEndpoint = site.formspreeEndpoint;
const hasForm = Boolean(formspreeEndpoint);
---

<div class="grid grid-cols-1 gap-10 md:grid-cols-12">
  <div class={hasForm ? 'md:col-span-5' : 'md:col-span-8'}>
    <p data-i18n="contact.intro" class="max-w-[60ch] text-base leading-relaxed text-muted">
      Open to PhD and graduate-study opportunities, R&amp;D engineering roles in water and membrane technology, and research collaborations.
    </p>

    <div class="mt-6 flex flex-col gap-3">
      <div class="flex flex-wrap gap-2">
        <button
          id="reveal-email-btn"
          type="button"
          data-encoded="bXVoYXNpcGkxMUBnbWFpbC5jb20="
          data-i18n="contact.emailBtn"
          class="inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-4 py-2 text-sm font-medium text-white dark:text-slate-950 hover:opacity-90"
        >
          Reveal &amp; Email
        </button>
        <button
          id="copy-email-btn"
          type="button"
          data-encoded="bXVoYXNpcGkxMUBnbWFpbC5jb20="
          data-i18n="contact.copyBtn"
          class="inline-flex min-h-[44px] items-center justify-center rounded border border-border bg-elevated px-4 py-2 text-sm font-medium text-ink hover:border-accent hover:text-accent"
        >
          Copy Address
        </button>
      </div>
      <p id="email-display" aria-live="polite" class="hidden font-mono text-xs text-accent"></p>

      {site.whatsappEncoded && (
        <div>
          <button
            id="whatsapp-btn"
            type="button"
            data-encoded={site.whatsappEncoded}
            class="inline-flex min-h-[44px] items-center justify-center rounded border border-border bg-elevated px-4 py-2 text-sm font-medium text-ink hover:border-accent hover:text-accent"
          >
            WhatsApp
          </button>
        </div>
      )}

      <div class="mt-2 flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/muhammadasipi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded border border-border bg-elevated px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent"
        >
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/m-asipi-qostolani-30155512b"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded border border-border bg-elevated px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent"
        >
          LinkedIn
        </a>
        {site.orcidUrl && (
          <a
            href={site.orcidUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] items-center rounded border border-border bg-elevated px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent"
          >
            ORCID
          </a>
        )}
        {site.cvUrl && (
          <a
            href={site.cvUrl}
            download
            data-i18n="hero.cta.cv"
            class="inline-flex min-h-[44px] items-center rounded border border-border bg-elevated px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent"
          >
            Download CV
          </a>
        )}
      </div>
    </div>
  </div>

  {hasForm && (
  <form
    id="contact-form"
    action={formspreeEndpoint}
    method="POST"
    class="space-y-4 rounded border border-border bg-elevated p-6 md:col-span-7"
  >
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div>
      <label for="contact-name" data-i18n="contact.form.name" class="mb-1.5 block text-sm font-medium text-ink">
        Name
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        required
        class="min-h-[44px] w-full rounded border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
      />
    </div>

    <div>
      <label for="contact-email" data-i18n="contact.form.email" class="mb-1.5 block text-sm font-medium text-ink">
        Email
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        class="min-h-[44px] w-full rounded border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
      />
    </div>

    <div>
      <label for="contact-subject" data-i18n="contact.form.subject" class="mb-1.5 block text-sm font-medium text-ink">
        Inquiry Type
      </label>
      <select
        id="contact-subject"
        name="subject"
        class="min-h-[44px] w-full rounded border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
      >
        <option value="job" data-i18n="contact.form.subject.job">R&amp;D / Engineering Role</option>
        <option value="phd" data-i18n="contact.form.subject.phd">Graduate Study / PhD / Scholarship</option>
        <option value="collab" data-i18n="contact.form.subject.collab">Research Collaboration</option>
        <option value="other" data-i18n="contact.form.subject.other">General Inquiry</option>
      </select>
    </div>

    <div>
      <label for="contact-message" data-i18n="contact.form.message" class="mb-1.5 block text-sm font-medium text-ink">
        Message
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        class="w-full rounded border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
      ></textarea>
    </div>

    <div class="flex items-center justify-between gap-4">
      <button
        id="contact-submit"
        type="submit"
        data-i18n="contact.form.submit"
        class="inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-5 py-2.5 text-sm font-medium text-white dark:text-slate-950 hover:opacity-90"
      >
        Send Message
      </button>
      <p id="form-status" role="status" aria-live="polite" class="text-xs text-muted"></p>
    </div>
  </form>
  )}
</div>
