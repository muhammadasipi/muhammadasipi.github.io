---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ContactForm from '../components/ContactForm.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes')).filter((n) => !n.data.draft);

const researchAreas = [
  { key: 'area1', code: '01' },
  { key: 'area2', code: '02' },
  { key: 'area3', code: '03' },
  { key: 'area4', code: '04' },
];

const skillGroups = [
  {
    key: 'skills.cat1',
    items: ['Phase-Field Modeling', 'Cahn-Hilliard Equation', 'Flory-Huggins Thermodynamics', 'Phase Separation Kinetics'],
  },
  {
    key: 'skills.cat2',
    items: ['Python', 'NumPy', 'CUDA / GPU Computing', 'Google Colab', 'Spectral & Finite-Difference Solvers'],
  },
  {
    key: 'skills.cat3',
    items: ['Polymeric Membranes', 'PVDF Systems', 'Non-Solvent Induced Phase Separation (NIPS)', 'Membrane Morphology & Macrovoids'],
  },
];
---

<BaseLayout
  title="M Asipi Qostolani | Membrane & Materials Researcher"
  description="Personal portfolio of M Asipi Qostolani, MS Materials Science and Engineering graduate from KFUPM, specializing in membrane distillation, desalination, and phase-field modeling."
  hasNotes={notes.length > 0}
  publications={publications}
>
  <Hero />

  <section id="about" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <h2 data-i18n="about.heading" class="font-serif text-2xl font-normal text-ink">About</h2>
        </div>
        <div class="md:col-span-8">
          <p data-i18n="about.bio" class="max-w-[65ch] text-base leading-relaxed text-ink">
            Materials scientist holding an MS in Materials Science and Engineering from King Fahd University of Petroleum &amp; Minerals (KFUPM). My research centers on polymeric membrane development for desalination and water treatment, with specific work on directional-pore architectures for membrane distillation. Alongside experimental work, I build GPU-accelerated phase-field simulations to investigate thermodynamics and kinetics of membrane structure formation.
          </p>
          <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-border pt-6 text-sm sm:grid-cols-2">
            <div>
              <dt data-i18n="about.meta.locationLabel" class="font-mono text-xs text-muted">Location</dt>
              <dd data-i18n="about.meta.locationValue" class="mt-1 text-ink">[TODO: City, Country]</dd>
            </div>
            <div>
              <dt data-i18n="about.meta.languagesLabel" class="font-mono text-xs text-muted">Languages</dt>
              <dd data-i18n="about.meta.languagesValue" class="mt-1 text-ink">
                Indonesian ([TODO: proficiency]), English ([TODO: proficiency])
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="research" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8 max-w-[65ch]">
        <h2 data-i18n="research.heading" class="font-serif text-2xl font-normal text-ink">Research Directions</h2>
        <p data-i18n="research.subtitle" class="mt-2 text-sm text-muted">
          Current scientific focus areas across membrane engineering and computational modeling.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {researchAreas.map((area) => (
          <div class="rounded border border-border bg-elevated p-6">
            <span class="font-mono text-xs text-accent">{area.code}</span>
            <h3 data-i18n={`research.${area.key}.title`} class="mt-2 font-serif text-lg font-normal text-ink">
              {area.key}
            </h3>
            <p data-i18n={`research.${area.key}.desc`} class="mt-2 text-sm leading-relaxed text-muted">
              Description
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8 max-w-[65ch]">
        <h2 data-i18n="projects.heading" class="font-serif text-2xl font-normal text-ink">Featured Projects</h2>
        <p data-i18n="projects.subtitle" class="mt-2 text-sm text-muted">
          Case studies will publish with full methodology, results, and explicit model limitations once finalized.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section id="publications" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="publications.heading" class="font-serif text-2xl font-normal text-ink">Publications</h2>
      </div>

      <div class="space-y-4">
        {publications.map((pub) => (
          <PublicationItem publication={pub} />
        ))}
      </div>
    </div>
  </section>

  <section id="skills" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="skills.heading" class="font-serif text-2xl font-normal text-ink">Technical Capabilities</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {skillGroups.map((group) => (
          <div class="rounded border border-border bg-elevated p-6">
            <h3 data-i18n={group.key} class="font-serif text-lg font-normal text-ink">
              {group.key}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded border border-border bg-surface px-3 py-1 font-mono text-xs text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="rounded border border-dashed border-border bg-elevated p-6">
          <h3 data-i18n="skills.cat4" class="font-serif text-lg font-normal text-ink">
            Membrane Fabrication &amp; Characterization
          </h3>
          <p data-i18n="skills.cat4.todo" class="mt-3 font-mono text-xs leading-relaxed text-accent">
            [TODO: Add confirmed fabrication and characterization techniques, e.g., phase inversion, electrospinning, SEM, contact angle, MD flux testing]
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="education" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <h2 data-i18n="education.heading" class="font-serif text-2xl font-normal text-ink">
            Education &amp; Academic Record
          </h2>
        </div>

        <ol class="relative space-y-8 border-l border-border pl-6 md:col-span-8">
          <li>
            <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
            <h3 data-i18n="education.ms.degree" class="font-serif text-lg font-normal text-ink">
              MS in Materials Science and Engineering
            </h3>
            <p data-i18n="education.ms.inst" class="mt-1 text-sm text-ink">
              King Fahd University of Petroleum &amp; Minerals (KFUPM)
            </p>
            <p data-i18n="education.ms.meta" class="mt-1 font-mono text-xs text-accent">
              Graduation Year: [TODO] | Advisor: [TODO]
            </p>
          </li>

          <li>
            <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full border border-accent bg-surface"></span>
            <h3 data-i18n="education.bs.degree" class="font-serif text-lg font-normal text-ink">
              Bachelor's Degree in [TODO: Major]
            </h3>
            <p data-i18n="education.bs.inst" class="mt-1 text-sm text-ink">
              [TODO: University Name]
            </p>
            <p data-i18n="education.bs.meta" class="mt-1 font-mono text-xs text-accent">
              Graduation Year: [TODO]
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section id="contact" class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="contact.heading" class="font-serif text-2xl font-normal text-ink">Contact</h2>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
