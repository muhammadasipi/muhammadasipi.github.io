---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ContactForm from '../components/ContactForm.astro';
import { ui } from '../i18n/ui';

const t = ui.en;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes')).filter((n) => !n.data.draft);

const researchAreas = [
  { key: 'area1', code: '01' },
  { key: 'area2', code: '02' },
  { key: 'area3', code: '03' },
  { key: 'area4', code: '04' },
];

const skillGroups = [
  {
    key: 'skills.cat1',
    descKey: 'skills.cat1.desc',
    items: [
      'Cahn-Hilliard Phase-Field Modeling',
      'Flory-Huggins Thermodynamics',
      'Coupled Fluid Flow / Advection-Diffusion',
      'Vitrification & Gelation Kinetics',
    ],
  },
  {
    key: 'skills.cat2',
    descKey: 'skills.cat2.desc',
    items: [
      'Python (NumPy, SciPy, Matplotlib)',
      'CUDA / GPU Acceleration',
      'Numba (JIT)',
      'Spectral (FFT/DCT) & Finite-Difference Solvers',
      'Git & Linux Environment',
    ],
  },
  {
    key: 'skills.cat3',
    descKey: 'skills.cat3.desc',
    items: [
      'Non-Solvent Induced Phase Separation (NIPS)',
      'Combined Crystallization & Diffusion (CCD)',
      'Electrospinning',
      'Nanocomposite Formulation (PVDF, PVDF-HFP)',
    ],
  },
  {
    key: 'skills.cat4',
    descKey: 'skills.cat4.desc',
    items: [
      'Scanning Electron Microscopy (SEM)',
      'Water Contact Angle (WCA)',
      'Membrane Distillation (MD) Flux & Salt Rejection',
      'Pore Size & Porosity Analysis',
      'General Materials Characterization (Thermal, Structural & Spectroscopic)',
    ],
  },
];
---

<BaseLayout
  title="M Asipi Qostolani | Membrane & Materials Researcher"
  description="Personal portfolio of M Asipi Qostolani, MS Materials Science and Engineering graduate from KFUPM, specializing in membrane distillation, desalination, and phase-field modeling."
  hasNotes={notes.length > 0}
  publications={publications}
>
  <Hero />

  <section id="about" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <h2 data-i18n="about.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">About</h2>
        </div>
        <div class="md:col-span-8">
          <p data-i18n="about.bio" class="max-w-[65ch] text-base leading-relaxed text-ink">
            Materials scientist holding an MS in Materials Science and Engineering from King Fahd University of Petroleum &amp; Minerals (KFUPM). My research centers on polymeric membrane development for desalination and water treatment, with specific work on directional-pore architectures for membrane distillation. Alongside experimental work, I build GPU-accelerated phase-field simulations to investigate thermodynamics and kinetics of membrane structure formation.
          </p>
          <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-border pt-6 text-sm sm:grid-cols-2">
            <div>
              <dt data-i18n="about.meta.locationLabel" class="font-mono text-xs text-muted">Location</dt>
              <dd data-i18n="about.meta.locationValue" class="mt-1 text-ink">Bandung, Indonesia</dd>
            </div>
            <div>
              <dt data-i18n="about.meta.languagesLabel" class="font-mono text-xs text-muted">Languages</dt>
              <dd data-i18n="about.meta.languagesValue" class="mt-1 text-ink">
                Indonesian (Native), English (Fluent)
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="research" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8 max-w-[65ch]">
        <h2 data-i18n="research.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">Research Directions</h2>
        <p data-i18n="research.subtitle" class="mt-2 text-sm text-muted">
          Current scientific focus areas across membrane engineering and computational modeling.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {researchAreas.map((area) => (
          <div class="rounded border border-border bg-elevated p-6">
            <span class="font-mono text-xs text-accent">{area.code}</span>
            <h3 data-i18n={`research.${area.key}.title`} class="mt-2 font-sans text-lg font-semibold tracking-tight text-ink">
              {t[`research.${area.key}.title` as keyof typeof t]}
            </h3>
            <p data-i18n={`research.${area.key}.desc`} class="mt-2 text-sm leading-relaxed text-muted">
              {t[`research.${area.key}.desc` as keyof typeof t]}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8 max-w-[65ch]">
        <h2 data-i18n="projects.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">Featured Projects</h2>
        <p data-i18n="projects.subtitle" class="mt-2 text-sm text-muted">
          Case studies will publish with full methodology, results, and explicit model limitations once finalized.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section id="publications" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="publications.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">Publications</h2>
      </div>

      <div class="space-y-4">
        {publications.map((pub) => (
          <PublicationItem publication={pub} />
        ))}
      </div>

      <div class="mt-10">
        <h3 data-i18n="conferences.heading" class="font-sans text-lg font-semibold tracking-tight text-ink">
          Conference Presentations
        </h3>
        <div class="mt-4 rounded border border-border bg-elevated p-5">
          <p data-i18n="conferences.eds2025.title" class="font-sans text-base font-semibold leading-snug text-ink">
            Unidirectional porous membrane prepared by combined crystallization and diffusion method for desalination
          </p>
          <p class="mt-2 text-sm text-ink">
            <strong class="font-semibold">M Asipi Qostolani</strong>, Mohammed Abdul Azeem, Turki Nabieh Baroud
          </p>
          <p data-i18n="conferences.eds2025.event" class="mt-1 text-sm text-muted">
            European Desalination Society (EDS) Conference 2025: Desalination for the Environment: Clean Water and Energy
          </p>
          <p data-i18n="conferences.eds2025.meta" class="mt-2 font-mono text-xs text-accent">
            Porto, Portugal | 27-30 April 2025 | Abstract No. 38
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="skills.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">Technical Capabilities</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {skillGroups.map((group) => (
          <div class="rounded border border-border bg-elevated p-6">
            <h3 data-i18n={group.key} class="font-sans text-lg font-semibold tracking-tight text-ink">
              {t[group.key as keyof typeof t]}
            </h3>
            <p data-i18n={group.descKey} class="mt-1.5 text-sm leading-relaxed text-muted">
              {t[group.descKey as keyof typeof t]}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded border border-border bg-surface px-3 py-1 font-mono text-xs text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="border-b border-border py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-4">
          <h2 data-i18n="education.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">
            Education &amp; Academic Record
          </h2>
        </div>

        <div class="space-y-10 md:col-span-8">
          <ol class="relative space-y-8 border-l border-border pl-6">
            <li>
              <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full bg-accent"></span>
              <h3 data-i18n="education.ms.degree" class="font-sans text-lg font-semibold tracking-tight text-ink">
                MS in Materials Science and Engineering
              </h3>
              <p data-i18n="education.ms.inst" class="mt-1 text-sm text-ink">
                King Fahd University of Petroleum &amp; Minerals (KFUPM)
              </p>
              <p data-i18n="education.ms.meta" class="mt-1 font-mono text-xs text-muted">
                Graduation Year: 2025 | Advisor: Prof. Turki Nabieh Baroud
              </p>
            </li>

            <li>
              <span class="absolute -left-[5px] mt-1.5 h-2.5 w-2.5 rounded-full border border-accent bg-surface"></span>
              <h3 data-i18n="education.bs.degree" class="font-sans text-lg font-semibold tracking-tight text-ink">
                Bachelor's Degree in Physics (Materials Physics Specialization)
              </h3>
              <p data-i18n="education.bs.inst" class="mt-1 text-sm text-ink">
                UIN Sunan Gunung Djati Bandung
              </p>
              <p data-i18n="education.bs.meta" class="mt-1 font-mono text-xs text-muted">
                Graduation Year: 2020
              </p>
            </li>
          </ol>

        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-14 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mb-8">
        <h2 data-i18n="contact.heading" class="font-sans text-2xl font-semibold tracking-tight text-ink">Contact</h2>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
