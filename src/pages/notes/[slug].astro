---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
---

<BaseLayout title={`${note.data.title} | Research Notes`} description={note.data.summary} hasNotes={true}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <a href="/notes" data-i18n="notes.back" class="inline-flex min-h-[44px] items-center font-mono text-xs text-accent hover:underline">
      &larr; All Research Notes
    </a>
    <header class="mt-4 border-b border-border pb-6">
      <time datetime={note.data.date.toISOString()} class="font-mono text-xs text-muted">
        {note.data.date.toISOString().slice(0, 10)}
      </time>
      <h1 class="mt-2 font-sans text-3xl font-bold tracking-tight text-ink">{note.data.title}</h1>
    </header>
    <div class="mt-8 space-y-4 text-base leading-relaxed text-ink">
      <Content />
    </div>
  </article>
</BaseLayout>
