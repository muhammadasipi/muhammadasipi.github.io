---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Research Notes | M Asipi Qostolani"
  description="Working derivations, numerical simulation notes, and membrane literature summaries."
  hasNotes={notes.length > 0}
>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <h1 data-i18n="notes.heading" class="font-serif text-3xl font-normal text-ink">Research Notes</h1>
    <p data-i18n="notes.subtitle" class="mt-2 text-sm text-muted">
      Working derivations, numerical benchmarks, and membrane literature notes.
    </p>

    {notes.length === 0 ? (
      <p data-i18n="notes.empty" class="mt-8 rounded border border-dashed border-border p-6 font-mono text-xs text-muted">
        No public research notes published yet.
      </p>
    ) : (
      <div class="mt-8 space-y-4">
        {notes.map((note) => (
          <article class="rounded border border-border bg-elevated p-6">
            <time datetime={note.data.date.toISOString()} class="font-mono text-xs text-muted">
              {note.data.date.toISOString().slice(0, 10)}
            </time>
            <h2 class="mt-1 font-serif text-xl font-normal text-ink">
              <a href={`/notes/${note.slug}`} class="hover:text-accent hover:underline">
                {note.data.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-muted">{note.data.summary}</p>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
