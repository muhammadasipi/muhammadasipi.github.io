---
import type { CollectionEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  hasNotes?: boolean;
  publications?: CollectionEntry<'publications'>[];
}

const { title, description, hasNotes = false, publications = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://muhammadasipi.github.io');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'M Asipi Qostolani',
  jobTitle: 'Membrane and Materials Researcher',
  url: 'https://muhammadasipi.github.io',
  sameAs: [
    'https://github.com/muhammadasipi',
    'https://www.linkedin.com/in/m-asipi-qostolani-30155512b',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bandung',
    addressCountry: 'Indonesia',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'King Fahd University of Petroleum & Minerals',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'UIN Sunan Gunung Djati Bandung',
    },
  ],
  knowsAbout: [
    'Membrane technology',
    'Membrane distillation',
    'Directional pore membrane',
    'Desalination',
    'Water treatment',
    'Phase-field modeling',
    'Computational materials',
  ],
};

const articleSchemas = publications.map((pub) => {
  const schema: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: pub.data.title,
    url: pub.data.url,
  };
  if (pub.data.year) schema.datePublished = pub.data.year;
  if (pub.data.journal) schema.isPartOf = { '@type': 'Periodical', name: pub.data.journal };
  if (pub.data.volume) schema.volumeNumber = pub.data.volume;
  if (pub.data.issue) schema.issueNumber = pub.data.issue;
  if (pub.data.page) schema.pageStart = pub.data.page;
  return schema;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="membrane technology, membrane distillation, directional pore membrane, desalination, water treatment, phase-field modeling, computational materials" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.15/dist/katex.min.css"
      crossorigin="anonymous"
    />

    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {articleSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <Header hasNotes={hasNotes} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script is:inline define:vars={{ ui }}>
      (function () {
        const themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          });
        }

        let currentLang = localStorage.getItem('lang') === 'id' ? 'id' : 'en';
        const langBtn = document.getElementById('lang-toggle');

        function applyLanguage(lang) {
          document.documentElement.lang = lang;
          if (langBtn) langBtn.textContent = lang === 'en' ? 'EN | ID' : 'ID | EN';
          const dict = ui[lang] || ui.en;
          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const key = el.getAttribute('data-i18n');
            if (key && dict[key]) {
              el.textContent = dict[key];
            }
          });
        }

        applyLanguage(currentLang);

        if (langBtn) {
          langBtn.addEventListener('click', () => {
            currentLang = currentLang === 'en' ? 'id' : 'en';
            localStorage.setItem('lang', currentLang);
            applyLanguage(currentLang);
          });
        }

        const revealBtn = document.getElementById('reveal-email-btn');
        const copyBtn = document.getElementById('copy-email-btn');
        const emailDisplay = document.getElementById('email-display');

        if (revealBtn) {
          revealBtn.addEventListener('click', () => {
            const decoded = atob(revealBtn.getAttribute('data-encoded') || '');
            if (emailDisplay) {
              emailDisplay.textContent = decoded;
              emailDisplay.classList.remove('hidden');
            }
            window.location.href = 'mailto:' + decoded;
          });
        }

        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            const decoded = atob(copyBtn.getAttribute('data-encoded') || '');
            await navigator.clipboard.writeText(decoded);
            const dict = ui[currentLang] || ui.en;
            copyBtn.textContent = dict['contact.copied'];
            setTimeout(() => {
              copyBtn.textContent = dict['contact.copyBtn'];
            }, 2000);
          });
        }

        const form = document.getElementById('contact-form');
        const statusEl = document.getElementById('form-status');
        const submitBtn = document.getElementById('contact-submit');

        if (form && statusEl && submitBtn) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const dict = ui[currentLang] || ui.en;
            submitBtn.disabled = true;
            statusEl.textContent = dict['contact.form.sending'];

            try {
              const res = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' },
              });
              if (res.ok) {
                form.reset();
                statusEl.textContent = dict['contact.form.success'];
              } else {
                statusEl.textContent = dict['contact.form.error'];
              }
            } catch {
              statusEl.textContent = dict['contact.form.error'];
            } finally {
              submitBtn.disabled = false;
            }
          });
        }
      })();
    </script>
  </body>
</html>
